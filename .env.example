# Copy this file to .env and fill in your local PostgreSQL settings.
# .env is git-ignored; never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=resume_validator
DB_USER=postgres
DB_PASSWORD=

# Separate database used only by the tests. It is created automatically
# and its applications table is cleared on every test run.
TEST_DB_NAME=resume_validator_test
